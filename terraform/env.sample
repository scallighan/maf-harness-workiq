# Copy to .env (git-ignored), edit, and load from the repository root:
#   set -a; source terraform/.env; set +a
# Interactive deployment uses `az login`. Terraform can alternatively use
# ARM_TENANT_ID, ARM_CLIENT_ID and ARM_CLIENT_SECRET for CI; keep secrets out
# of source control. The deploy scripts require Azure CLI login.

export ARM_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
export TF_VAR_subscription_id="$ARM_SUBSCRIPTION_ID"
export TF_VAR_gh_repo="scallighan/maf-harness-workiq"
export TF_VAR_location="EastUS2"

# Optional overrides
# export TF_VAR_chat_model="gpt-5.6-luna"
# export TF_VAR_chat_model_version="2026-07-09"
# Alternative: set both TF_VAR_chat_model="gpt-5.4-mini" and TF_VAR_chat_model_version="2026-03-17".
# export TF_VAR_chat_model_capacity="50"
# export TF_VAR_workiq_toolbox_name="work-iq-toolbox"
# export TAG="my-release"
