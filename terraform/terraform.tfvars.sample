# Copy to terraform.tfvars and fill in. Never commit real secrets.
subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "EastUS2"
gh_repo         = "scallighan/maf-harness-workiq"

# Optional overrides
# chat_model          = "gpt-5.6-luna"
# chat_model_version  = "2026-07-09"
# Alternative: set both chat_model = "gpt-5.4-mini" and chat_model_version = "2026-03-17".
# chat_model_capacity = 50
# user_object_ids     = ["ENTRA_USER_OBJECT_ID"]
# agent_name          = "workplace-productivity"
# agent_cpu           = "1"
# agent_memory        = "2Gi"
# history_retention_days = 30
# workiq_toolbox_name = "work-iq-toolbox"
# workiq_mcp_connection_name = "work-iq-mcp"
# workiq_mcp_allowed_tools = ["ask", "fetch", "get_schema", "search_paths", "fetch_blob"]
# workiq_mcp_require_approval = "never"
# workiq_mcp_secret_version = "1" # Set/increment when creating or rotating a credential.
# setup_toolbox.py persists Foundry's OAuth redirect URL in toolbox.auto.tfvars.

# scripts/deploy.sh persists the immutable image in agent.auto.tfvars.
# scripts/deploy_ui.sh persists the optional UI image in ui.auto.tfvars.
# ui_min_replicas = 0
# ui_additional_redirect_uris = ["http://localhost:5173/"]
# OAuth secrets and access/refresh tokens never belong here.
